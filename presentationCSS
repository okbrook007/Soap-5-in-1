* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: Arial, sans-serif;
    background: #f5f7fa;
    color: #222;
}
nav {
    background: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 8px #bbb;
}
nav h2 { color: #159957; }
.nav-links {
    display: flex;
    gap: 20px;
    align-items: center;
}
.nav-links a {
    text-decoration: none;
    color: #333;
    font-weight: bold;
}
.nav-links button,
.buy-button,
.checkout-button {
    border: none;
    background: #159957;
    color: white;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
}
.hero {
    min-height: 500px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 80px;
    padding: 60px 10%;
    background: linear-gradient(135deg, #dfffe9, white);
}
.hero-text { max-width: 500px; }
.hero-text h1 {
    font-size: 50px;
    color: #159957;
    margin-bottom: 20px;
}
.hero-text p {
    font-size: 22px;
    margin-bottom: 20px;
}
.hero-text h2 {
    font-size: 32px;
    margin-bottom: 20px;
}
.product-picture,
.big-bottle {
    background: #159957;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
}
.product-picture {
    width: 260px;
    height: 360px;
    border-radius: 30px;
    font-size: 130px;
    box-shadow: 10px 15px 30px #aaa;
}
.buy-button {
    font-size: 18px;
    font-weight: bold;
}
.buy-button:hover,
.checkout-button:hover {
    background: #0d7542;
}
section {
    padding: 60px 8%;
}
.section-title,
.product-section > h2 {
    text-align: center;
    font-size: 35px;
    margin-bottom: 40px;
}
.uses-container {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}
.use-card {
    width: 190px;
    background: white;
    padding: 30px 20px;
    text-align: center;
    border-radius: 15px;
    box-shadow: 0 4px 15px #ddd;
}
.icon {
    font-size: 50px;
    margin-bottom: 15px;
}
.use-card h3 {
    font-size: 22px;
    margin-bottom: 10px;
}
.use-card p { color: #666; }
.product-section { background: white; }
.product-box {
    max-width: 900px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 80px;
}
.big-bottle {
    width: 250px;
    height: 340px;
    border-radius: 25px;
    font-size: 120px;
}
.product-info h1 {
    font-size: 35px;
    margin-bottom: 15px;
}
.product-info p {
    font-size: 18px;
    margin-bottom: 20px;
}
.product-info h2 {
    font-size: 30px;
    margin-bottom: 20px;
}
.popup {
    display: none;
    position: fixed;
    z-index: 10;
    inset: 0;
    background: #0009;
}
.popup-content {
    background: white;
    width: 400px;
    max-width: 90%;
    margin: 100px auto;
    padding: 30px;
    border-radius: 15px;
    position: relative;
}
.close {
    position: absolute;
    right: 20px;
    top: 10px;
    font-size: 30px;
    cursor: pointer;
}
#cartItems {
    padding: 15px 0;
    font-size: 18px;
}
.quantity {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
}
.quantity button {
    width: 30px;
    height: 30px;
    border: none;
    background: #159957;
    color: white;
    border-radius: 5px;
    cursor: pointer;
}
.checkout-button {
    width: 100%;
    margin-top: 20px;
    font-size: 17px;
    font-weight: bold;
}
footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 30px;
}
footer h3 { margin-bottom: 10px; }
@media (max-width: 700px) {
    nav,
    .hero,
    .product-box {
        flex-direction: column;
    }
    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
    }
    .hero {
        gap: 40px;
        text-align: center;
    }
    .hero-text h1 { font-size: 40px; }
    .product-box {
        gap: 40px;
        text-align: center;
    }
}
